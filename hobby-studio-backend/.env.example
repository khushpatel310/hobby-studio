# ==========================================
# Hobby Studio Production Environment Template
# ==========================================

# Server Port (Render / Railway set this automatically)
PORT=5000

# Environment Mode (development or production)
NODE_ENV=production

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.yuw8lte.mongodb.net/hobbystudio

# JWT Secret Key (Use a long, random secure string)
JWT_SECRET=hobby_studio_secret_key_2026_super_secure_production_token

# Frontend URL (For production CORS - set to your frontend domain)
FRONTEND_URL=https://hobbystudio.in

# Super Admin Credentials
ADMIN_EMAIL=admin@hobbystudio.com
ADMIN_PASSWORD=Hobby@Studio#2026

# Email Notifications (Gmail SMTP)
# To enable email alerts for new bookings:
# 1. Enable 2-Step Verification on your Gmail account.
# 2. Generate a 16-character "App Password" at https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password below:
EMAIL_USER=hobbystudiophotography@gmail.com
EMAIL_PASS=HobbyStudio@1981
NOTIFICATION_EMAIL=hobbystudiophotography@gmail.com
